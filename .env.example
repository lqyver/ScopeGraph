SCOPEGRAPH_EDITION=community
SCOPEGRAPH_COMPOSE_PROJECT=scopegraph-community
SCOPEGRAPH_API_HOST_PORT=18000
SCOPEGRAPH_MCP_HOST_PORT=18001
SCOPEGRAPH_WEB_HOST_PORT=18080
SCOPEGRAPH_ENVIRONMENT=development
SCOPEGRAPH_LOG_LEVEL=INFO
SCOPEGRAPH_DATABASE_URL=postgresql+asyncpg://scopegraph:scopegraph@db:5432/scopegraph
SCOPEGRAPH_REDIS_URL=redis://redis:6379/0
SCOPEGRAPH_DATA_ROOT=/data
# Host-side CLI default. Compose overrides this inside Python containers because
# the API listens on container-local port 8000.
SCOPEGRAPH_API_URL=http://127.0.0.1:18000
# MCP 默认只允许查询。仅在本地管理员明确授权 Agent 启动已确认 Scope 的
# Quick/Standard 收集任务时改为 true；Deep、全端口和 Nuclei 始终不会通过 MCP 开放。
SCOPEGRAPH_MCP_ALLOW_SCAN_START=false
SCOPEGRAPH_MCP_HOST=127.0.0.1
SCOPEGRAPH_MCP_PORT=8001
# Docker 默认仅发布到 127.0.0.1。若主动改成非回环监听，必须同时启用以下两项：
# SCOPEGRAPH_PUBLIC_BIND=true
# SCOPEGRAPH_API_KEY=replace-with-a-long-random-secret
API_INTERNAL_URL=http://api:8000
# Browser Host allowlist for the server-side API proxy. Keep the default
# loopback-only policy for local deployments; use comma-separated hostnames for
# a deliberately exposed deployment behind TLS and access controls.
# SCOPEGRAPH_WEB_ALLOWED_HOSTS=scopegraph.example.com
# Maximum proxied mutation body in bytes (default: 10 MiB, hard ceiling: 50 MiB).
# SCOPEGRAPH_PROXY_MAX_BODY_BYTES=10485760

# Optional Docker build mirror overrides. Leave unset for the official Debian
# endpoints. A mainland-China build can opt in explicitly, for example:
# SCOPEGRAPH_DEBIAN_MIRROR=http://mirrors.ustc.edu.cn/debian
# SCOPEGRAPH_DEBIAN_SECURITY_MIRROR=http://mirrors.ustc.edu.cn/debian-security

POSTGRES_DB=scopegraph
POSTGRES_USER=scopegraph
# Development-only local credential. Never reuse this value outside the default
# loopback-only Docker Compose setup; set a strong unique secret before any
# non-local deployment.
POSTGRES_PASSWORD=scopegraph
