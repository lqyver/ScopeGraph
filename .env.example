SCOPEGRAPH_ENVIRONMENT=development
SCOPEGRAPH_LOG_LEVEL=INFO
SCOPEGRAPH_DATABASE_URL=postgresql+asyncpg://scopegraph:scopegraph@db:5432/scopegraph
SCOPEGRAPH_REDIS_URL=redis://redis:6379/0
SCOPEGRAPH_DATA_ROOT=/data
SCOPEGRAPH_API_URL=http://127.0.0.1:8000
# MCP 默认只允许查询。仅在本地管理员明确授权 Agent 启动已确认 Scope 的
# Quick/Standard 收集任务时改为 true；Deep、全端口和 Nuclei 始终不会通过 MCP 开放。
SCOPEGRAPH_MCP_ALLOW_SCAN_START=false
SCOPEGRAPH_MCP_HOST=127.0.0.1
SCOPEGRAPH_MCP_PORT=8001
# Docker 默认仅发布到 127.0.0.1。若主动改成非回环监听，必须同时启用以下两项：
# SCOPEGRAPH_PUBLIC_BIND=true
# SCOPEGRAPH_API_KEY=replace-with-a-long-random-secret
API_INTERNAL_URL=http://api:8000

POSTGRES_DB=scopegraph
POSTGRES_USER=scopegraph
# Development-only local credential. Never reuse this value outside the default
# loopback-only Docker Compose setup; set a strong unique secret before any
# non-local deployment.
POSTGRES_PASSWORD=scopegraph
